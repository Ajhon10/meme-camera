{
  "name": "memecam",
  "version": "0.3.4",
  "private": true,
  "description": "Local, gesture-powered camera effects for Windows",
  "author": "Ajan Jeresano",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "setup:assets": "node scripts/setup-assets.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "build": "npm run typecheck && npm run build:runtime && vite build",
    "start": "electron .",
    "package:win": "npm run build:native && npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  },
  "build": {
    "appId": "local.memecam.desktop",
    "productName": "MemeCam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/memes/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/memes/app-icon.ico",
      "uninstallerIcon": "public/memes/app-icon.ico"
    },
    "extraResources": [
      {
        "filter": [
          "*.exe",
          "*.dll"
        ],
        "from": "native/bin/Release",
        "to": "native"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "USER_GUIDE.md",
          "MEETINGS.md",
          "TROUBLESHOOTING.md",
          "PRIVACY.md",
          "TERMS.md"
        ]
      }
    ]
  }
}
